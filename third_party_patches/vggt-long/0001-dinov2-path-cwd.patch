+        # runs from any directory but its own (always, under reifyscene). Anchor it to this file.
+        import os as _os
+        _dinov2_repo = _os.path.join(_os.path.dirname(_os.path.dirname(_os.path.abspath(__file__))), 'dinov2')
+        self.model = torch.hub.load(_dinov2_repo, model_name, source='local', pretrained=False)
         self.model.load_state_dict(torch.load(vggt_long_config['Weights']['DNIO']))
