+def greedy_nms_from_ious(ious: torch.Tensor, scores: torch.Tensor, iou_threshold: float) -> torch.Tensor:
+    """
+    Greedy NMS over a precomputed pairwise IoU matrix, in plain PyTorch: the highest-scoring detection is kept, and
+    every detection whose IoU with it exceeds `iou_threshold` is dropped, until none remain. The same rule as the
+    original SAM 3 implementation's CPU fallback (`generic_nms_cpu`).
+    Args:
+      - ious: (N, N) float Tensor, pairwise IoUs
+      - scores: (N,) float Tensor, one score per detection
+      - iou_threshold: float, IoU above which the lower-scoring detection is dropped
+    Returns:
+      - kept_inds: (K,) int64 Tensor on the device of `scores`, indices of the kept detections in score order
+    """
+    ious_cpu = ious.detach().float().cpu()
+    order = torch.argsort(scores.detach().float().cpu(), descending=True)
+    kept = []
+    while order.numel() > 0:
+        i = int(order[0])
+        kept.append(i)
+        rest = order[1:]
+        order = rest[ious_cpu[i, rest] <= iou_threshold]
+    return torch.tensor(kept, dtype=torch.int64, device=scores.device)
+
