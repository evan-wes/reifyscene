+    def _suppress_cross_prompt_duplicates(
+        self,
+        det_out: dict[str, Tensor],
+        det_idx_to_prompt_id: dict[int, int],
+    ) -> tuple[dict[str, Tensor], dict[int, int]]:
+        """
+        Greedy mask NMS across prompts: of any merged detections whose masks overlap by more than
+        `cross_prompt_nms_thresh`, only the highest-scoring is kept, whichever prompt found it. The kept detections
+        stay in their merged order, and `det_idx_to_prompt_id` is re-indexed to match.
+        """
+        masks_binary = det_out["mask"] > 0
+        ious = mask_iou(masks_binary, masks_binary)
+        kept = greedy_nms_from_ious(ious, det_out["scores"], self.cross_prompt_nms_thresh).sort().values
+        kept_out = {key: value[kept] for key, value in det_out.items()}
+        kept_idx_to_prompt_id = {
+            new_idx: det_idx_to_prompt_id[old_idx] for new_idx, old_idx in enumerate(kept.tolist())
+        }
+        return kept_out, kept_idx_to_prompt_id
